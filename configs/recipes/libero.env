# Canonical downstream defaults. Existing environment values take precedence.
export ENCODER=${ENCODER:-vjepa2_1_vitl}
export ENCODER_FAMILY=${ENCODER_FAMILY:-vjepa2_1}
export ENCODER_MODEL_NAME=${ENCODER_MODEL_NAME:-vit_large}
export ENCODER_CHECKPOINT_KEY=${ENCODER_CHECKPOINT_KEY:-ema_encoder}
export NUM_GPUS=${NUM_GPUS:-8}
export BATCH_SIZE=${BATCH_SIZE:-16}
export GRAD_ACCUM=${GRAD_ACCUM:-1}
export GLOBAL_BATCH_SIZE=${GLOBAL_BATCH_SIZE:-128}
export MAX_STEPS=${MAX_STEPS:-21360}
export CONTEXT_LEN=${CONTEXT_LEN:-128}
export MAX_STATE_DIM=${MAX_STATE_DIM:-48}
export ACTIVATION_CHECKPOINTING_BLOCKS=${ACTIVATION_CHECKPOINTING_BLOCKS:-8}
export SAVE_EVERY=${SAVE_EVERY:-4000}
