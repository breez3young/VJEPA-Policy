# Copy to configs/libero_eval.local.env; edit paths before sourcing.
# Use a clean shell without encoder overrides from another training run.
export RUN_DIR="/path/to/policy_run"
export CHECKPOINT="$RUN_DIR/checkpoint_step021360.pt"
export DATASET_STATS="$RUN_DIR/dataset_stats.json"
export VJEPA2_ENCODER_CHECKPOINT="/path/to/matching_encoder.pt"
export TEXT_EMBEDDING_CACHE="/path/to/libero_t5_cache"
export POLICY_PYTHON="/path/to/policy_env/bin/python"
export LIBERO_PYTHON="/path/to/libero_env/bin/python"
export EVAL_GPUS=0,1,2,3
# For one GPU: export EVAL_GPUS=0 EVAL_SERIAL=1
export EVAL_SUITES=libero_spatial,libero_object,libero_goal,libero_10
export NUM_TRIALS_PER_TASK=50
export EVAL_SEED=7
export REPLAN_STEPS=16
export LIBERO_MUJOCO_GL=egl
# Set a fresh EVAL_DIR for each launch; the default is timestamped.
# Leave encoder, geometry, text length, and state overrides unset for new checkpoints.
# For a legacy checkpoint, consult examples/libero/README.md and the original run config.
