# Copy to configs/gr1_vjepa21.local.env, edit paths, then source the copy.
export DATA_ROOT=/path/to/gr1_dataset
export ARTIFACT_ROOT=$DATA_ROOT/artifacts
export WEIGHTS=/path/to/encoder_checkpoints

# Loads recipe defaults; values already exported in your shell are preserved.
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/recipes/gr1.env"
