# Copy to configs/libero_vjepa21.local.env, edit paths, then source the copy.
export LIBERO_DATA_ROOT=/path/to/LEROBOT_LIBERO_DATA
export VJEPA2_ENCODER_CHECKPOINT=/path/to/vjepa2_1_vitl_checkpoint.pt
export TEXT_EMBEDDING_CACHE=/path/to/libero_t5_cache

# Loads recipe defaults; values already exported in your shell are preserved.
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/recipes/libero.env"
