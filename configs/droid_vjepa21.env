# Copy to configs/droid_vjepa21.local.env, edit paths, then source the copy.
export DATASET_ROOT=/path/to/Droid_v21
export TEXT_CACHE_DIR=/path/to/droid_t5_cache
export ENCODER_CHECKPOINT=/path/to/vjepa2_1_vitl_checkpoint.pt

# Loads recipe defaults; values already exported in your shell are preserved.
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/recipes/droid.env"
