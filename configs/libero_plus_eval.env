# Copy to configs/libero_plus_eval.local.env; edit paths before sourcing.
export RUN_DIR="/path/to/policy_run"
export CHECKPOINT="$RUN_DIR/checkpoint_step021360.pt"
export DATASET_STATS="$RUN_DIR/dataset_stats.json"
export VJEPA2_ENCODER_CHECKPOINT="/path/to/matching_encoder.pt"
export TEXT_EMBEDDING_CACHE="/path/to/libero_plus_t5_cache"
export POLICY_PYTHON="/path/to/policy_env/bin/python"
export LIBERO_PLUS_PYTHON="/path/to/libero_plus_env/bin/python"
export LIBERO_PLUS_ROOT="/path/to/LIBERO-plus"
export LIBERO_CONFIG_PATH="$LIBERO_PLUS_ROOT/.local-config"
export LIBERO_PLUS_MANIFEST="$RUN_DIR/libero_plus_tasks.json"
export EVAL_GPUS=0,1,2,3
# For one GPU: export EVAL_GPUS=0 EVAL_SERIAL=1
export EVAL_SUITES=libero_spatial,libero_object,libero_goal,libero_10
export NUM_TRIALS_PER_TASK=1
export EVAL_SEED=7
export REPLAN_STEPS=16
export FRAME_STRIDE=4
export RECORD_VIDEO=0
export LIBERO_MUJOCO_GL=egl
# Set a fresh EVAL_DIR for every launch; the Plus wrapper defaults to a timestamp.
# Keep checkpoint geometry overrides unset unless needed for a legacy checkpoint.
